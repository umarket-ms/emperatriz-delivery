  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "latest",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "jest": "^29.2.1",
    "jest-expo": "^57.0.2",
    "react-test-renderer": "19.1.0",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  },
  "private": true
