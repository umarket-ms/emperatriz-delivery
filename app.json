{
  "expo": {
    "name": "tiendas dominicanas delivery",
    "slug": "emperatriz-delivery",
    "version": "1.0.0",
    "autolinking": {
      "buildFromSource": ["expo-task-manager", "unimodules-app-loader"]
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/d9114a6d-b3be-4b76-b734-ce5aefdc980c",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tiendasdominicanasdelivery",
    "extra": {
      "apiUrl": {
        "EXPO_PUBLIC_API_URL_PROD": "https://api.mundeko.com",
        "EXPO_PUBLIC_API_URL_DEV_IOS": "http://localhost:80",
        "EXPO_PUBLIC_API_URL_DEV_ANDROID": "http://192.168.100.41:5500",
        "EXPO_PUBLIC_API_URL_DEFAULT": "http://192.168.100.41:5500"
      },
      "socketUrl": {
        "development": "http://192.168.100.41:5500",
        "production": "https://api.mundeko.com"
      },
      "SENTRY_DSN": "https://576eb575e45146d3ac2395192d8cf6b5@glitchtip.mundeko.com/6",
      "router": {
        "root": "./app"
      },
      "eas": {
        "projectId": "d9114a6d-b3be-4b76-b734-ce5aefdc980c"
      }
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta aplicación necesita acceso a tu ubicación para mostrar rutas de entrega.",
        "NSLocationAlwaysUsageDescription": "Esta aplicación necesita acceso a tu ubicación para mostrar rutas de entrega."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A1125"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "package": "com.valentinrod.tiendasdominicanas.mensajeria",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "geo"
            },
            {
              "scheme": "http",
              "host": "maps.google.com"
            },
            {
              "scheme": "https",
              "host": "maps.google.com"
            },
            {
              "scheme": "https",
              "host": "www.google.com",
              "pathPrefix": "/maps"
            },
            {
              "scheme": "https",
              "host": "google.com",
              "pathPrefix": "/maps"
            }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "./modules/expo-pip-local/app.plugin.js",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "Esta aplicación necesita acceso a tu ubicación para mostrar rutas de entrega."
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/screen.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A1125"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "tiendas-dominicanas",
          "project": "delivery",
          "url": "https://glitchtip.mundeko.com"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación necesita acceso a tu galería para adjuntar evidencia de entrega.",
          "cameraPermission": "La aplicación necesita acceso a tu cámara para tomar fotos de evidencia de entrega."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "valentinrod"
  }
}